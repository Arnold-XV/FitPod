# Solid Pod Authentication (for tools/scripts only)
# Generate client credentials at your Pod provider's account page
# For local CSS: http://localhost:3001/.account/

SOLID_CLIENT_ID=
SOLID_CLIENT_SECRET=
SOLID_OIDC_ISSUER=http://localhost:3001

