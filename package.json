{
  "name": "fitpod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FitPod — decentralized fitness tracking on Solid Pods",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @fitpod/web",
    "build": "npm run build -w @fitpod/web",
    "preview": "npm run preview -w @fitpod/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "pod:start": "tsx tools/solid-pod/server.ts",
    "seed": "tsx tools/seed/seed.ts"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "n3": "^2.13.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "4.1.12"
  }
}
